# OpenAI API key
OPENAI_API_KEY=your-openai-key

# PostgreSQL connection settings
PGHOST=localhost
PGUSER=postgres
PGDATABASE=whatsapp_bot
PGPASSWORD=password
PGPORT=5432

# Admin interface settings
ADMIN_PASSWORD=your-password
ADMIN_PORT=3001
# Secret used to sign session cookies
SESSION_SECRET=change-me

# Logging
LOG_LEVEL=info

# Maximum reconnection attempts for WhatsApp
MAX_RECONNECTS=5

# Number of messages before conversations are summarized
SUMMARY_MESSAGE_LIMIT=20
# Delay (ms) between sending messages in bulk (0-60000)
BULK_MESSAGE_DELAY=500

# Daily token limit per organization
DAILY_TOKEN_LIMIT=100000

# Redis connection for BullMQ
REDIS_URL=redis://localhost:6379

# Optional webhook to receive conversation events
WEBHOOK_URL=

