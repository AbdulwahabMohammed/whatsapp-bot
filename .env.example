# OpenAI API key
OPENAI_API_KEY=your-openai-key

# PostgreSQL connection settings
PGHOST=localhost
PGUSER=postgres
PGDATABASE=whatsapp_bot
PGPASSWORD=password
PGPORT=5432

# Admin interface settings
ADMIN_PASSWORD=your-password
ADMIN_PORT=3001

# Logging
LOG_LEVEL=info

# Maximum reconnection attempts for WhatsApp
MAX_RECONNECTS=5

# Daily token limit per organization
DAILY_TOKEN_LIMIT=100000

