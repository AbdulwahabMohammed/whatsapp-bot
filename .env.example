# OpenAI API key
OPENAI_API_KEY=your-openai-key

# PostgreSQL connection settings
PGHOST=db
PGUSER=postgres
PGDATABASE=whatsapp_bot
PGPASSWORD=password
PGPORT=5432

# Admin interface settings
ADMIN_PASSWORD=your-password
ADMIN_PORT=3001
# Secret used to sign session cookies (REQUIRED - generate a strong unique value)
SESSION_SECRET=please-generate-a-strong-secret

# Logging
LOG_LEVEL=info

# Maximum reconnection attempts for WhatsApp
MAX_RECONNECTS=5

# Number of messages before conversations are summarized
SUMMARY_MESSAGE_LIMIT=20
# Delay (ms) between sending messages in bulk (0-60000)
BULK_MESSAGE_DELAY=500

# Daily token limit per organization
DAILY_TOKEN_LIMIT=100000

# Language detection toggle (set to 'false' to skip auto-detection)
# DETECT_LANGUAGE=false

# Fast dev mode (leave unset in production to keep default timings)
# FAST_DEV=true
# RUN_MAX_RETRIES=20
# RUN_INITIAL_DELAY_MS=300
# RUN_MAX_DELAY_MS=1500
# RUN_DELAY_GROWTH=1.15
# CONNECTION_RETRY_DELAY=1000
# BULK_MESSAGE_DELAY=0

# Redis connection for BullMQ
REDIS_URL=redis://redis:6379

# Optional webhook to receive conversation events
WEBHOOK_URL=

