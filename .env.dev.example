# Development defaults for the WhatsApp bot
# Copy to .env for a fast local feedback loop.

# Core credentials
OPENAI_API_KEY=your-openai-key
PGHOST=localhost
PGUSER=postgres
PGDATABASE=whatsapp_bot
PGPASSWORD=password
PGPORT=5432
REDIS_URL=redis://localhost:6379

# Admin UI
ADMIN_PASSWORD=admin
ADMIN_PORT=3001
SESSION_SECRET=dev-session-secret-change-me

# Logging & limits
LOG_LEVEL=debug
SUMMARY_MESSAGE_LIMIT=10
DAILY_TOKEN_LIMIT=0

# Fast development mode toggles
FAST_DEV=true
DETECT_LANGUAGE=false
RUN_MAX_RETRIES=20
RUN_INITIAL_DELAY_MS=300
RUN_MAX_DELAY_MS=1500
RUN_DELAY_GROWTH=1.15
CONNECTION_RETRY_DELAY=1000
BULK_MESSAGE_DELAY=0

# Optional webhook sink (leave blank if unused)
WEBHOOK_URL=
