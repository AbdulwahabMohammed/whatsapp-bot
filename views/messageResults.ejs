<!DOCTYPE html>
<html>
<head>
  <title>Message Results</title>
</head>
<body>
<h1>Message Results</h1>
<a href="/messages">Back</a>
<form action="/messages" method="post">
  <input type="hidden" name="phone" value="<%= phone %>"/>
  <input type="hidden" name="from" value="<%= from %>"/>
  <input type="hidden" name="to" value="<%= to %>"/>
  <button type="submit" name="export" value="csv">Export CSV</button>
  <button type="submit" name="export" value="pdf">Export PDF</button>
</form>
<ul>
<% results.forEach(function(r){ %>
  <li>
    <%= r.created_at.toISOString().slice(0,16).replace('T',' ') %> |
    <%= r.organization %> |
    <%= r.customer_phone %> |
    <%= r.sender %> :
    <%= r.text %>
    <% if (r.attachment_path) { %>
      <% if (r.attachment_type === 'image') { %>
        <br/><img src="/<%= r.attachment_path.replace(/^[.\\/]+/, '') %>" width="150"/>
      <% } else { %>
        <a href="/<%= r.attachment_path.replace(/^[.\\/]+/, '') %>">Attachment</a>
      <% } %>
    <% } %>
  </li>
<% }); %>
</ul>
<h2>Conversation Summaries</h2>
<ul>
<% summaries.forEach(function(s){ %>
  <li>
    <strong><%= s.customer_phone %></strong>: <%= s.summary %>
    <% if (!s.escalated) { %>
      <form action="/conversations/<%= s.id %>/escalate" method="post" style="display:inline;">
        <button type="submit">تولي المحادثة</button>
      </form>
    <% } else { %>
      (تم التصعيد)
    <% } %>
  </li>
<% }); %>
</ul>
</body>
</html>
