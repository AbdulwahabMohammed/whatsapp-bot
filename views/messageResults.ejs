<h1 class="mb-3">Message Results</h1>
<form action="/messages" method="post" class="mb-3">
  <%- include('partials/csrf') %>
  <input type="hidden" name="phone" value="<%= phone %>">
  <input type="hidden" name="from" value="<%= from %>">
  <input type="hidden" name="to" value="<%= to %>">
  <button class="btn btn-sm btn-secondary" type="submit" name="export" value="csv">Export CSV</button>
  <button class="btn btn-sm btn-secondary" type="submit" name="export" value="pdf">Export PDF</button>
</form>
<ul class="list-group mb-4">
<% results.forEach(function(r){ %>
  <li class="list-group-item">
    <%= r.created_at.toISOString().slice(0,16).replace('T',' ') %> |
    <%= r.organization %> |
    <%= r.customer_phone %> |
    <%= r.sender %> :
    <%= r.text %>
    <% if (r.attachment_path) { %>
      <% if (r.attachment_type === 'image') { %>
        <br><img src="/<%= r.attachment_path.replace(/^[.\\/]+/, '') %>" width="150">
      <% } else { %>
        <a href="/<%= r.attachment_path.replace(/^[.\\/]+/, '') %>">Attachment</a>
      <% } %>
    <% } %>
  </li>
<% }); %>
</ul>
<h2>Conversation Summaries</h2>
<ul class="list-group">
<% summaries.forEach(function(s){ %>
  <li class="list-group-item">
    <strong><%= s.customer_phone %></strong>: <%= s.summary %>
    <% if (!s.escalated) { %>
      <form action="/conversations/<%= s.id %>/escalate" method="post" class="d-inline">
        <%- include('partials/csrf') %>
        <button class="btn btn-sm btn-warning" type="submit">تولي المحادثة</button>
      </form>
    <% } else { %>
      (تم التصعيد)
    <% } %>
  </li>
<% }); %>
</ul>
