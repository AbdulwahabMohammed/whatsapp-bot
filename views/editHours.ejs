<h1 class="mb-3">Edit Working Hours for <%= name %></h1>
<form action="/org/<%= orgId %>/hours" method="post" style="max-width:400px;">
  <%- include('partials/csrf') %>
  <div class="mb-3">
    <label class="form-label">Start</label>
    <input class="form-control" type="time" name="working_hours_start" value="<%= start %>">
  </div>
  <div class="mb-3">
    <label class="form-label">End</label>
    <input class="form-control" type="time" name="working_hours_end" value="<%= end %>">
  </div>
  <button class="btn btn-primary" type="submit">Save</button>
</form>
