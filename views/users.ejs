<h1 class="mb-3">Users</h1>
<a class="btn btn-primary mb-3" href="/users/new">Add User</a>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Username</th>
      <th>Role</th>
      <th>Organization</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% users.forEach(function(u){ %>
    <tr>
      <td><%= u.username %></td>
      <td colspan="2">
        <form action="/users/<%= u.id %>/role" method="post" class="d-flex align-items-center">
          <select class="form-select form-select-sm me-2" name="role">
            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
            <option value="editor" <%= u.role === 'editor' ? 'selected' : '' %>>editor</option>
          </select>
          <select class="form-select form-select-sm me-2" name="organization_id">
            <option value="">None</option>
            <% orgs.forEach(function(o){ %>
              <option value="<%= o.id %>" <%= u.organization_id === o.id ? 'selected' : '' %>><%= o.name %></option>
            <% }); %>
          </select>
          <button class="btn btn-sm btn-secondary" type="submit">Update</button>
        </form>
      </td>
      <td>
        <form action="/users/<%= u.id %>/disable-2fa" method="post" class="d-inline" data-confirm="Disable 2FA for this user?">
          <button class="btn btn-sm btn-warning" type="submit">Disable 2FA</button>
        </form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
