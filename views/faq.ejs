<h1 class="mb-3">FAQ Suggestions</h1>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Question</th>
      <th>Count</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% faqs.forEach(function(f){ %>
    <tr>
      <td><%= f.question %></td>
      <td><%= f.count %></td>
      <td>
        <form action="/faq/<%= f.id %>/delete" method="post" class="d-inline" data-confirm="Delete this suggestion?">
          <button class="btn btn-sm btn-danger" type="submit">Delete</button>
        </form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
