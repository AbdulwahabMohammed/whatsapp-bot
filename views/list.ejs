<h1 class="mb-3">Organizations</h1>
<div class="mb-3">
  <a class="btn btn-primary" href="/org/new">Add Organization</a>
</div>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Phone</th>
      <th>Language</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
  <% orgs.forEach(function(o){ %>
    <tr>
      <td><%= o.name %></td>
      <td><%= o.phone %></td>
      <td><%= o.language %></td>
      <td>
        <form action="/org/<%= o.id %>/assistant" method="post" class="d-inline">
          <button class="btn btn-sm btn-secondary" type="submit">Create Assistant</button>
        </form>
        <a class="btn btn-sm btn-secondary" href="/org/<%= o.id %>/upload">Upload File</a>
        <a class="btn btn-sm btn-secondary" href="/org/<%= o.id %>/hours">Edit Hours</a>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
