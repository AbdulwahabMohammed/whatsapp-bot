<h1 class="mb-3">Profile</h1>
<p>Username: <%= username %></p>
<p>Role: <%= role %></p>
<p>2FA: <%= enabled ? 'enabled' : 'disabled' %></p>
<% if (!enabled) { %>
  <a class="btn btn-primary" href="/profile/setup-2fa">تفعيل المصادقة الثنائية</a>
<% } else { %>
  <form action="/profile/disable-2fa" method="post" class="d-inline" data-confirm="Are you sure you want to disable 2FA?">
    <button class="btn btn-danger" type="submit">تعطيل المصادقة الثنائية</button>
  </form>
<% } %>
