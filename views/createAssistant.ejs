<h1 class="mb-3">Create Assistant for Organization <%= orgId %></h1>
<form action="/org/<%= orgId %>/assistant" method="post">
  <div class="mb-3">
    <label class="form-label">Instructions</label>
    <textarea class="form-control" name="instructions" rows="5"><%= instructions %></textarea>
  </div>
  <button class="btn btn-primary" type="submit">Create</button>
</form>
